<!DOCTYPE html>
<html>
  <head>
    <title>HealNow Embedded Checkout Demo</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <main>
      <h1>HealNow Embedded Checkout Demo</h1>
      <form>
        <div id="payment-form"></div>
      </form>
    </main>
    <script src="https://js.healnow.io/payments-ui/v1.0.0/"></script>
    <script>
      const initialize = (sessionId) => {
        const checkout = PaymentsUI.checkout('<%= base_url %>', sessionId, { emailRequired: true });

        checkout.mount('#payment-form');
      }

      const createSession = () => fetch('/api/checkout-session', {
        method: 'post',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      createSession()
        .then(response => response.json())
        .then(session => initialize(session.id))
        .catch(message => console.log('Error: Failed creating checkout session.', message.error));
    </script>
  </body>
</html>
