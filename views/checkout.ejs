<!DOCTYPE html>
<html>
  <head>
    <title>HealNow Embedded Checkout Demo</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <main>
      <h1>HealNow Embedded Checkout Demo</h1>
      <form>
        <div id="payment-form"></div>
      </form>
    </main>
    <script src="https://js.healnow.io/payments-ui/v1.1.0/"></script>
    <script>
      const createSession = () => fetch('/api/checkout-session', {
        method: 'post',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const initialize = (checkoutUrl) => {
        const checkout = PaymentsUI.checkout(checkoutUrl);

        // Unmount checkout in 5 seconds after successful payment
        checkout.onPayment((order) => {
          console.log('Order payload:', order);

          setTimeout(() => {
            checkout.unmount('#payment-form');
          }, 5000);
        });

        // Handle errors that block further checkout
        checkout.onError((error) => {
          console.log('Error:', error);
        });

        // Mount checkout
        checkout.mount('#payment-form');
      }

      createSession()
        .then(response => response.json())
        .then(session => initialize(session.checkout_url))
        .catch(message => console.log('Error: Failed creating checkout session.', message.error));
    </script>
  </body>
</html>
